{
admin off
}

# Production: set EVA_DOMAIN=app.example.com and Caddy obtains/renews certificates
# automatically and redirects :80 to :443. Unset, it serves plain HTTP on :80 so a
# fresh `docker compose up` works on a laptop without a domain.
{$EVA_DOMAIN:http://localhost} {
encode zstd gzip

# HSTS only over TLS: sending it on plaintext is ignored by browsers and would
# poison local dev. `includeSubDomains` is safe because the whole apex is ours.
@tls protocol https
header @tls Strict-Transport-Security "max-age=31536000; includeSubDomains"
header @tls X-Content-Type-Options "nosniff"
header @tls X-Frame-Options "DENY"
header @tls Referrer-Policy "strict-origin-when-cross-origin"

# `handle`, not `handle_path`: the api mounts its routes at /api/v1/... and
# handle_path would strip the /api prefix, sending /v1/... to a 404.
handle /api/* {
reverse_proxy api:8000
}

# Widget assets and the demo host page (WIDG-01/02, M3 gate). These are NOT under
# /api, so without this block they fall through to the dashboard and 404 -- which is
# exactly what happened on the first live attempt. The loader is served from the
# same origin as the API it calls, so the iframe needs no cross-origin wiring.
handle /widget/* {
reverse_proxy api:8000
}

handle /demo/* {
reverse_proxy api:8000
}

handle {
reverse_proxy dashboard:3000
}
}
