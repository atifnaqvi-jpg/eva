# Placeholders only — never commit real values.
POSTGRES_PASSWORD=changeme
# Password for the non-superuser runtime role (created by the WP-02 migration).
EVA_APP_DB_PASSWORD=changeme_app
# Signs public widget session tokens (PLAN 8.13). Required: without it the widget
# routes fail closed with 503. Generate with: openssl rand -hex 32
WIDGET_TOKEN_SECRET=changeme_generate_with_openssl_rand_hex_32

# BYOK vault (SEC-03/SEC-04). SECRET_VAULT_HOST_DIR holds age-encrypted tenant
# provider keys; SECRET_VAULT_IDENTITY_HOST is the age identity that decrypts them.
# Both live outside the repo and are gitignored. Generate the identity once with:
#   mkdir -p .secrets && chmod 700 .secrets && age-keygen -o .secrets/age-identity
# Losing the identity loses every stored provider key, by design.
SECRET_VAULT_HOST_DIR=./.secrets
SECRET_VAULT_IDENTITY_HOST=./.secrets/age-identity

# Alerts (OPS-04, ARCHITECTURE §22/§27). ALERT_EMAIL is the *operator's* mailbox and
# never a tenant's handover address: a platform alert names tenant ids and provider
# names, which is deployment topology a customer did not ask for. Unset means alerts are
# logged instead of sent — visible in the alert sweep report, not silent.
# Set it to a placeholder only; the real address goes in .env, which is gitignored.
ALERT_EMAIL=ops@example.invalid

# Thresholds. HALT-09 fixed industry defaults; these are starting values, so changing one
# is a .env edit and not a code deploy. The provider and budget pairs can also be
# overridden per tenant in tenants.settings -> alerts.
#   provider error rate: warn / critical as a fraction, plus an attempt floor below which
#   no rate is claimed (2 failures out of 2 turns is 100% and is not a spike)
ALERT_PROVIDER_ERROR_WARN=0.05
ALERT_PROVIDER_ERROR_CRITICAL=0.20
ALERT_PROVIDER_MIN_ATTEMPTS=10
#   monthly token budget: fraction of the tenant's budget used (1.00 = CONV-14 refuses)
ALERT_BUDGET_WARN=0.90
ALERT_BUDGET_CRITICAL=1.00
#   disk: fraction of the filesystem used
ALERT_DISK_WARN=0.85
ALERT_DISK_CRITICAL=0.95
ALERT_DISK_PATH=/
#   queue: arq job depth, and how long the warn depth must persist to count as a backlog
ALERT_QUEUE_WARN=100
ALERT_QUEUE_CRITICAL=500
ALERT_QUEUE_SUSTAIN_SECONDS=300
#   backup: the daily run plus slack. A failed run leaves no manifest, so it arrives here
#   as staleness; the directory must be mounted into the worker (see docs/ops/RUNBOOK.md)
ALERT_BACKUP_MAX_AGE_SECONDS=93600
ALERT_BACKUP_DIR=/var/backups/eva
# The host side of the read-only mount that puts OPS-09's manifests inside the worker.
# Defaults to the backup script's own default; point it at the off-box mount.
OPS09_BACKUP_HOST_DIR=/var/backups/eva
# The window the provider error rate is computed over (OPS-03's five minutes, so the
# graph and the alert cannot mean different things by "recently").
ALERT_WINDOW_SECONDS=300
