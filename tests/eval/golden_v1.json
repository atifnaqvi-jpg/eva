      "title": "Returns and Refunds Policy",
      "chunks": [
        {
          "id": "returns-window",
          "section": "Refund window",
          "text": "Customers may request a refund within thirty calendar days of delivery. Requests after thirty days are declined unless the item arrived damaged."
        },
        {
          "id": "returns-method",
          "section": "Refund method",
          "text": "Approved refunds are issued to the original payment method within five business days. Store credit is issued instantly if requested."
        },
        {
          "id": "returns-shipping",
          "section": "Shipping charges",
          "text": "Original shipping and handling charges are not refundable. Return shipping is free for damaged items and paid by the customer otherwise."
        }
      ]
    },
    {
      "slug": "shipping",
      "title": "Shipping and Delivery",
      "chunks": [
        {
          "id": "shipping-standard",
          "section": "Standard delivery",
          "text": "Standard delivery takes three to five business days within the continental region."
        },
        {
          "id": "shipping-free",
          "section": "Free shipping threshold",
          "text": "Orders above fifty dollars ship free. Orders below that threshold are charged a flat seven dollar fee."
        },
        {
          "id": "shipping-tracking",
          "section": "Tracking",
          "text": "A tracking number is emailed when the parcel leaves the warehouse. Tracking updates may lag by one business day."
        }
      ]
    },
    {
      "slug": "warranty",
      "title": "Product Warranty",
      "chunks": [
        {
          "id": "warranty-term",
          "section": "Coverage period",
          "text": "All electronics carry a twelve month warranty from the purchase date. Outerwear carries a twenty-four month warranty."
        },
        {
          "id": "warranty-exclusions",
          "section": "Exclusions",
          "text": "The warranty excludes accidental damage, water damage and normal wear. Repairs by unauthorised technicians void coverage."
        }
      ]
    },
    {
      "slug": "account",
      "title": "Account and Orders",
      "chunks": [
        {
          "id": "account-password",
          "section": "Password reset",
          "text": "A password reset link is valid for one hour and can only be used once. Request a new link if it expires."
        },
        {
          "id": "account-cancel",
          "section": "Cancelling an order",
          "text": "Orders can be cancelled free of charge before they are dispatched. Once dispatched, the return process applies."
        }
      ]
    }
